# Used only by scripts on your laptop (npm run seed:users). Never put these in the apps.
# Supabase dashboard > Project Settings > API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Database password you saved when creating the Supabase project (used by "supabase db push")
SUPABASE_DB_PASSWORD=

# Passwords for the seeded test accounts (at least 8 characters each)
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PASSWORD=
SEED_STUDENT_PASSWORD=
# Optional: leave empty and the professor accounts use SEED_STUDENT_PASSWORD
SEED_PROFESSOR_PASSWORD=
